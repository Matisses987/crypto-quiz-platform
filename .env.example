# ===== 服务端版配置（复制为 .env 后按需修改）=====
# 所有项都有内置默认值；不写 .env 也能启动。

# --- 监听 ---
# 手机 + SakuraFrp 场景绑回环即可；局域网直连验收时改成 0.0.0.0
HOST=127.0.0.1
PORT=3010

# --- 数据 ---
# SQLite 文件路径（相对仓库根目录）
CQP_DB=data/app.db
# 备份目录与每日备份时刻（HH:MM，24 小时制，空字符串表示关闭定时备份）
CQP_BACKUP_DIR=data/backup
CQP_BACKUP_CRON=03:10

# --- 账号 ---
# 1=开放注册  0=只允许管理员建号
CQP_ALLOW_REGISTER=1
# 会话有效期（天）
CQP_SESSION_DAYS=7
# 首次启动时自动建的管理员（仅在 users 表为空时生效；留空则第一个注册的人就是 admin）
CQP_BOOTSTRAP_ADMIN=
CQP_BOOTSTRAP_PASSWORD=

# --- 安全 ---
# 走 HTTPS 隧道或自己加了 TLS 反代才置 1；TCP 隧道外层是 http，置 1 会导致 cookie 失效
CQP_COOKIE_SECURE=0
# 仅当前面有可信反代（HTTP/HTTPS 隧道）时置 1，才会信任 X-Forwarded-For
# TCP 隧道不会带 XFF，此时保持 0，限流自动退化为按用户名
CQP_TRUST_PROXY=0
# 请求体上限（字节），题库上传走单独的更宽松上限
CQP_MAX_BODY=2097152

# --- 其它 ---
TZ=Asia/Shanghai
NODE_ENV=production
